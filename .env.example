DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_system?schema=public"
API_PORT=4000
API_PROXY_TARGET="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-production-secret"

# Cloudflare R2 (optional locally; required for hosted product images)
R2_PUBLIC_URL="https://images.example.com"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_BUCKET_NAME="pos-product-images"
R2_ACCESS_KEY_ID="replace-with-r2-access-key"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-key"
